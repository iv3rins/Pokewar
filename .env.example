NODE_ENV=development
PORT=3000
# Production single-host deployment should keep the Node service private behind Nginx.
HOST=127.0.0.1
# Production: at least 32 random bytes, never use the development default.
GUEST_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave empty in local development to use in-memory rooms and locks.
REDIS_URL=
REDIS_PREFIX=pokewar:

# Leave empty in local development to disable durable replay persistence.
DATABASE_URL=
